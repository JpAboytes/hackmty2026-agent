# Google Gemini API key used to draft the conversational reply.
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
# Optional: override the default model.
# GEMINI_MODEL=gemini-3.6-flash

# Remote FastMCP endpoint hosted by Prefect Horizon.
MCP_SERVER_URL=https://your-server.fastmcp.app/mcp

# Use "none" only for an explicitly unauthenticated local development server.
MCP_AUTH_MODE=horizon

# Server-side secret. Never expose this value to the mobile application.
HORIZON_API_KEY=fmcp_replace_with_real_secret
