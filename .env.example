# Google Gemini API key used to draft the conversational reply.
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
# Optional: override the default model.
# GEMINI_MODEL=gemini-3.6-flash

# Remote FastMCP endpoint hosted by Prefect Horizon.
MCP_SERVER_URL=https://your-server.fastmcp.app/mcp

# Use "none" only for an explicitly unauthenticated local development server.
MCP_AUTH_MODE=horizon

# Server-side secret. Never expose this value to the mobile application.
HORIZON_API_KEY=fmcp_replace_with_real_secret

# Supabase Auth project used to verify Mobile bearer tokens at the API boundary.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_public_key
# Legacy projects may set SUPABASE_ANON_KEY instead of SUPABASE_PUBLISHABLE_KEY.

# Comma-separated browser origins allowed to call the API. Leave unset to allow
# any localhost port, which is what the Expo web dev server uses. Native builds
# are not subject to CORS. Set this to the deployed web origin in production.
# AGENT_ALLOWED_ORIGINS=https://app.example.com

# Seconds a loaded MCP tool collection stays usable before it is loaded again.
# Schemas only change when the MCP server is redeployed, and loading them cost
# between 0.9s and 4.3s of every production turn. Set to 0 to disable the cache
# and pick up a redeploy immediately.
# MCP_TOOLS_CACHE_SECONDS=300

# Stage logging. INFO prints one line per agent stage plus a per-turn timing
# timeline; DEBUG adds stage starts and library transport logs.
LOG_LEVEL=INFO
# Opt-in, local debugging only: log truncated tool arguments, MCP results and
# the exact response sent to the client. Never enable this in a deployment
# that handles real accounts.
# LOG_PAYLOADS=1
# LOG_PAYLOAD_LIMIT=800

# Same random secret as MCP, at least 32 characters. Signs confirmed UI writes.
# MCP_ACTIONS_SECRET=REPLACE_WITH_A_RANDOM_SERVER_ONLY_SECRET
