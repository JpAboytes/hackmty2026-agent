# Google Gemini API key used to draft the conversational reply.
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
# Optional: override the default model.
# GEMINI_MODEL=gemini-3.6-flash

# Deployed hackmty2026-mcp endpoint (Prefect Horizon). Required in every
# environment except local offline development.
MCP_SERVER_URL=https://REPLACE_WITH_MCP_DEPLOYMENT.fastmcp.app/mcp
# "horizon" (default) requires HORIZON_API_KEY as a bearer token; use "none"
# only for an explicitly unauthenticated local development server.
MCP_AUTH_MODE=horizon
# Server-side secret. Never expose this value to the mobile application.
HORIZON_API_KEY=REPLACE_WITH_HORIZON_API_KEY

# Local offline development only: used instead of MCP_SERVER_URL when it is
# unset, to spawn hackmty2026-mcp as a local stdio subprocess.
# SUPABASE_MCP_DIR=../hackmty2026-mcp
# SUPABASE_MCP_PYTHON=../hackmty2026-mcp/.venv/bin/python
